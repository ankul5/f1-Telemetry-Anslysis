# API URL used by the Expo app. When testing on a physical device via Expo Go,
# "localhost" points at the phone itself, not this PC — so we point it at the
# machine's LAN IP instead. Update this if your PC's IP address changes
# (e.g. after reconnecting to Wi-Fi) or run `ipconfig` to find the current one.
EXPO_PUBLIC_API_URL=http://10.26.106.17:8000
